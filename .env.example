# LLM Configuration (required for daily report generation)
# 支持任何 OpenAI 兼容 API（DeepSeek / 通义千问 / 智谱 / OpenAI）

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Supabase (optional, enables DB persistence)
# Run storage/migrations/001_init_sources_signals.sql in Supabase SQL Editor first
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# WeChat Official Account (required for publishing)
WECHAT_APPID=your-appid-here
WECHAT_SECRET=your-secret-here

# DEPRECATED: Agnes image generation is disabled in production.
# Do not set these for image generation. Kept only for historical reference.
# AGNES_API_KEY=your-agnes-api-key-deprecated
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# Optional local image command template. Placeholders: {prompt} {width} {height} {output}
# ZEROREALM_LOCAL_IMAGE_CMD=

# Homepage image normalization and three-scene video assembly
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
# FFMPEG_VIDEO_ENCODER=libx264
