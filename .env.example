# LLM Configuration (OpenAI-compatible; DeepSeek V4 default)

# Canonical secret (preferred):
LLM_API_KEY=your-api-key-here
# Compatibility fallback only (do not prefer this in new setups):
# DEEPSEEK_API_KEY=

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional FX for approximate CNY cost estimates (cache-miss):
# LLM_USD_CNY_RATE=7.2

# Controlled content generation (default mock — never auto-live on key presence)
CONTENT_GENERATOR_PROVIDER=mock
CONTENT_GENERATOR_MODEL=deepseek-v4-flash
CONTENT_GENERATOR_ALLOW_LIVE=0
# CONTENT_GENERATOR_MAX_CALLS_PER_RUN=4
# CONTENT_GENERATOR_MAX_OUTPUT_TOKENS=2000

# Supabase (optional, enables DB persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# WeChat Official Account (required for publishing)
WECHAT_APPID=your-appid-here
WECHAT_SECRET=your-secret-here

# DEPRECATED: Agnes image generation is disabled in production.
# AGNES_API_KEY=your-agnes-api-key-deprecated
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# AnySearch Source Discovery (optional; CI uses mocks)
# ANYSEARCH_API_KEY=
# ANYSEARCH_BASE_URL=https://api.anysearch.com/mcp
# ANYSEARCH_ENABLED=true
