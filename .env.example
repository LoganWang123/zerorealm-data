# LLM Configuration (required for daily report generation)
# 支持任何 OpenAI 兼容 API（DeepSeek / 通义千问 / 智谱 / OpenAI）

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Supabase (optional, enables DB persistence)
# Run storage/migrations/001_init_sources_signals.sql in Supabase SQL Editor first
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# WeChat Official Account (required for publishing)
WECHAT_APPID=your-appid-here
WECHAT_SECRET=your-secret-here

# Agnes media generation (server-side only; never commit a real key)
AGNES_API_KEY=your-agnes-api-key
# Optional provider overrides
# AGNES_BASE_URL=https://api.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# AGNES_VIDEO_MODEL=agnes-video-v2.0
# AGNES_VIDEO_CREATE_PATH=/videos
# AGNES_VIDEO_STATUS_URL_TEMPLATE=https://apihub.agnes-ai.com/agnesapi?video_id={video_id}
