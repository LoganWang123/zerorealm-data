# =============================================================================
# Legacy / test-only external LLM APIs
# Dual-insurance timed collection (GitHub cron 0 15 + local launchd /
# scripts/run_local_collection.sh) UNSETS these and never calls
# DeepSeek/OpenAI/Anthropic/Gemini/Agnes. Prefer Cursor Auto +
# Antigravity (gemini-3.6-flash-medium) via:
#   /Users/Logan/AICoding/ZeroRealmAI/scripts/ai-delivery.sh zerorealm-data
# =============================================================================

# LLM Configuration (OpenAI-compatible; DeepSeek V4 default) — LEGACY / TEST-ONLY
# Canonical secret (preferred when manually testing legacy generators):
LLM_API_KEY=your-api-key-here
# Compatibility fallback only (do not prefer this in new setups):
# DEEPSEEK_API_KEY=

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional FX for approximate CNY cost estimates (cache-miss):
# LLM_USD_CNY_RATE=7.2

# Controlled content generation (default mock — never auto-live on key presence)
CONTENT_GENERATOR_PROVIDER=mock
CONTENT_GENERATOR_MODEL=deepseek-v4-flash
CONTENT_GENERATOR_ALLOW_LIVE=0
# CONTENT_GENERATOR_MAX_CALLS_PER_RUN=4
# CONTENT_GENERATOR_MAX_OUTPUT_TOKENS=2000

# Supabase — LEGACY / optional remote persistence (skipped by main.py --local-only)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-key

# WeChat Official Account — LEGACY / manual publish only (never used by timed collection)
# WECHAT_APPID=your-appid-here
# WECHAT_SECRET=your-secret-here

# DEPRECATED: Agnes image generation is disabled in production.
# Images: Antigravity gemini-3.6-flash-medium only.
# AGNES_API_KEY=your-agnes-api-key-deprecated
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# AnySearch Source Discovery (optional; CI uses mocks) — LEGACY / TEST-ONLY
# ANYSEARCH_API_KEY=
# ANYSEARCH_BASE_URL=https://api.anysearch.com/mcp
# ANYSEARCH_ENABLED=true

# Website sync token — LEGACY / manual only (timed collection never injects this)
# WEBSITE_REPO_TOKEN=
