{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerorealm.tech/contracts/public-v1/claim.schema.json",
  "title": "PublicClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "type",
    "confidence",
    "sourceIds",
    "basedOnClaimIds"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["fact", "inference", "opinion"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "basedOnClaimIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
